rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMe(uid) { return request.auth != null && request.auth.uid == uid; }
    function profile(uid) { return get(/databases/$(database)/documents/profiles/$(uid)).data; }
    function hasProfile(uid) { return exists(/databases/$(database)/documents/profiles/$(uid)); }

    // Coleção: o dono lê e escreve; outras pessoas só leem se o dono deixou o perfil público.
    match /users/{uid}/cards/{cardId} {
      allow read: if isMe(uid) || (hasProfile(uid) && profile(uid).privacy == 'public');
      allow write: if isMe(uid);
    }

    // Perfil público: qualquer um lê, menos quando o dono escolheu "privado".
    match /profiles/{uid} {
      allow read: if isMe(uid) || (resource != null && resource.data.privacy != 'private');
      allow write: if isMe(uid) && request.resource.data.uid == uid
        && request.resource.data.privacy in ['public', 'showcase', 'private'];
      allow delete: if isMe(uid);
    }

    // Nome de usuário único: só dá para criar um nome livre, e só o dono apaga o próprio.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Quem eu sigo (só eu altero) e quem me segue (cada um altera só a própria entrada).
    match /follows/{uid}/following/{other} {
      allow read: if true;
      allow write: if isMe(uid);
    }
    match /followers/{uid}/list/{other} {
      allow read: if true;
      allow write: if isMe(other);
    }
    // Atividade (cartas adicionadas): o dono escreve; amigos leem se o perfil não for privado.
    match /users/{uid}/activity/{aid} {
      allow read: if isMe(uid) || (request.auth != null && hasProfile(uid) && profile(uid).privacy != 'private');
      allow write: if isMe(uid);

      // Curtida: uma por pessoa, com o próprio uid como id.
      match /likes/{liker} {
        allow read: if request.auth != null;
        allow create: if isMe(liker) && request.resource.data.keys().hasOnly(['username', 'at']);
        allow delete: if isMe(liker);
      }
      // Comentário: quem escreveu apaga; o dono do post também.
      match /comments/{cid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
          && request.resource.data.keys().hasOnly(['uid', 'username', 'text', 'at']);
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isMe(uid));
      }
    }

    // Relatos de problema: qualquer pessoa envia (até convidado); só o desenvolvedor lê e apaga.
    match /reports/{rid} {
      allow create: if request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 400000
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow read, delete: if request.auth != null && request.auth.token.email == 'pedrohblour@gmail.com' && request.auth.token.email_verified == true;
    }
  }
}
