{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "boosterz",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "README.md",
      "**/.*",
      ".git/**",
      "**/.*/**",
      "**/node_modules/**",
      "tools/**",
      "_t/**",
      "thumbs.bin",
      "thumbs.ndjson"
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "data/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "icons/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}
